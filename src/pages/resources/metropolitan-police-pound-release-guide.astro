---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import PhoneCTA from "../../components/sections/PhoneCTA.astro";
import FAQ from "../../components/sections/FAQ.astro";
import { services } from "../../data";
import { breadcrumbSchema, faqSchema } from "../../utils/schema";
import { composeTitle } from "../../utils/seo";

const poundService = services.find((s) => s.slug === "police-pound-release");

const title = composeTitle("Met Police Pound Release Guide");
const description = "How to release your vehicle from a Metropolitan Police pound — paperwork, statutory fees, deadlines and how flatbed collection works. Read the guide.";

const guideFaqs = poundService?.faqs ?? [];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/resources/metropolitan-police-pound-release-guide/"
  schema={[
    faqSchema(guideFaqs),
    breadcrumbSchema([
      { label: "Home", path: "/" },
      { label: "Resources", path: "/resources/" },
      { label: "Metropolitan Police Pound Release Guide" },
    ]),
  ]}
>
  <div class="container-page breadcrumb-band">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Resources" },
        { label: "Metropolitan Police Pound Release Guide" },
      ]}
    />
  </div>

  <article class="guide container-page">
    <span class="section-label">Guide</span>
    <h1>How to get a vehicle out of a Metropolitan Police pound.</h1>
    <p class="guide__lead">
      A practical walk-through — the paperwork you'll need, the fees, the order of operations,
      and the window staff hours at Charlton and Perivale.
    </p>

    <h2>Which pound has your vehicle?</h2>
    <p>
      All Metropolitan Police-seized vehicles in London go to one of two main pounds:
      <strong><a href="/resources/charlton-car-pound/">Charlton</a></strong> (Bramshot Avenue,
      SE7 7HY — south-east London, off the A102) and
      <strong><a href="/resources/perivale-car-pound/">Perivale</a></strong> (Walmgate Road,
      UB6 7LR — west London, off the A40). The seizure notice given to the driver, or the
      notice letter posted to the registered keeper, states which pound holds the vehicle.
      Not sure? Call the Met pound line on 020 7161 0944. If the vehicle was towed by a
      council or TfL rather than the police, use the free TRACE service instead.
    </p>
    <p>
      We've put together dedicated pages for each pound with addresses, opening times,
      travel directions and the current fee tables:
      the <a href="/resources/perivale-car-pound/">Perivale Car Pound guide</a> and
      the <a href="/resources/charlton-car-pound/">Charlton Car Pound guide</a>.
    </p>

    <h2>What paperwork you'll need</h2>
    <ul class="guide__list">
      <li>
        <strong>V5 logbook</strong> showing you are the registered keeper. If the V5
        is with DVLA (recent change of keeper), a letter of authority from the new keeper
        plus DVLA confirmation of application is accepted at pound discretion.
      </li>
      <li>
        <strong>A current insurance certificate</strong> naming the driver who will
        collect the vehicle, or naming us if we're collecting on your behalf.
      </li>
      <li>
        <strong>Photo ID</strong> matching the person collecting (passport or
        photo driving licence).
      </li>
      <li>
        <strong>The release fee</strong> — payable to the pound by card.
        At 2026 rates, the statutory removal charge for a standard car or light
        van up to 3.5 tonnes, found upright on-road and not substantially damaged,
        is £192, with storage charged at £26 per 24 hours or part thereof. Charges
        vary by vehicle weight, condition and where it was recovered from.
      </li>
    </ul>

    <h2>If we're doing the release for you</h2>
    <p>
      Send us the V5, the insurance certificate and a signed letter of authority.
      We pay the release and storage fees on your behalf, load the vehicle onto a
      flatbed (most pound-held cars need PG9 inspection, which means no ground-tow),
      and deliver to your chosen address. Same-day turnaround in most cases.
      Our <a href="/services/police-pound-release/">police pound release service</a> page
      has the full details.
    </p>

    <h2>Opening hours</h2>
    <p>
      Both Charlton and Perivale pounds are open <strong>11.30am to 7.30pm, seven days a
      week, including public holidays</strong>. The gates close to the public at 7.30pm
      sharp, but if you arrive before closing you will be served. The busiest periods are
      midweek 11.30am–1pm and after 5pm. Neither pound has public parking or toilets on
      site — and remember the pounds don't allow repairs of any kind inside, so if the
      vehicle can't legally or safely be driven, arrange a
      <a href="/services/police-pound-release/">recovery collection</a> before you travel.
    </p>
  </article>

  <PhoneCTA
    tone="emergency"
    heading="Your car is at Charlton or Perivale?"
    lead="We'll handle the paperwork and deliver it to you, usually same-day."
  />

  {guideFaqs.length > 0 && <FAQ items={guideFaqs} heading="Common questions about pound release." />}

  <PhoneCTA tone="navy" />
</BaseLayout>

<style>
  .guide {
    padding-block: 2rem 3rem;
    max-width: 72ch;
  }
  .guide h1 {
    margin-top: 0.6rem;
  }
  .guide__lead {
    margin-top: 1rem;
    color: var(--color-neutral-700);
    line-height: 1.55;
    font-size: 1.1rem;
  }
  .guide h2 {
    margin-top: 2.25rem;
    margin-bottom: 0.5rem;
    font-size: 1.35rem;
  }
  .guide p {
    color: var(--color-neutral-800);
    line-height: 1.65;
  }
  .guide p + p { margin-top: 0.75rem; }
  .guide a {
    color: var(--color-primary-700);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .guide__list {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .guide__list li {
    color: var(--color-neutral-800);
    line-height: 1.55;
  }
</style>
