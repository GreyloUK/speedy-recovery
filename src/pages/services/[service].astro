---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import Icon from "../../components/ui/Icon.astro";
import Hero from "../../components/sections/Hero.astro";
import TrustRibbon from "../../components/sections/TrustRibbon.astro";
import ServiceDetail from "../../components/sections/ServiceDetail.astro";
import PhoneCTA from "../../components/sections/PhoneCTA.astro";
import Process from "../../components/sections/Process.astro";
import ReviewsGoogle from "../../components/sections/ReviewsGoogle.astro";
import FAQ from "../../components/sections/FAQ.astro";
import AreasCovered from "../../components/sections/AreasCovered.astro";
import ServicesNav from "../../components/sections/ServicesNav.astro";
import { services, sharedFaqs } from "../../data";
import type { Service } from "../../data/services";
import {
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
} from "../../utils/schema";
import { composeTitle } from "../../utils/seo";

export async function getStaticPaths() {
  return services.map((s) => ({
    params: { service: s.slug },
    props: { service: s },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

const title = composeTitle(service.seoTitle);
const description = service.metaDescription;

const combinedFaqs = [...service.faqs, ...sharedFaqs.slice(0, 2)];
const otherServices = services.filter((s) => s.slug !== service.slug).map((s) => s.slug);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/services/${service.slug}/`}
  schema={[
    serviceSchema(service),
    faqSchema(combinedFaqs),
    breadcrumbSchema([
      { label: "Home", path: "/" },
      { label: "Services", path: "/services/" },
      { label: service.name, path: `/services/${service.slug}/` },
    ]),
  ]}
>
  <div class="container-page breadcrumb-band-tight">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Services", href: "/services/" },
        { label: service.name },
      ]}
    />
  </div>

  <Hero
    variant="service"
    eyebrow={service.name}
    title={service.heroTitle}
    lead={service.shortDescription}
    image={service.heroImage ?? service.gridImage}
    imageAlt={`${service.name} on the road in London + M25`}
  />

  <TrustRibbon />

  <ServiceDetail
    longDescription={service.longDescription}
    detailSections={service.detailSections}
    bullets={service.bullets}
    priceNote={service.priceNote}
    serviceSlug={service.slug}
    galleryImages={service.galleryImages}
  />

  {((service.relatedResources && service.relatedResources.length > 0) ||
    (service.relatedAreas && service.relatedAreas.length > 0)) && (
    <div class="container-page related-stack">
      {service.relatedResources && service.relatedResources.length > 0 && (
        <section class="related-card">
          <div class="related-card__head">
            <span class="section-label">Before you travel</span>
            <h2>Pound guides &amp; resources</h2>
          </div>
          <ul class="related-card__links">
            {service.relatedResources.map((r) => (
              <li>
                <a href={r.href}>
                  <span>{r.label}</span>
                  <Icon name="arrow-right" size={16} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {service.relatedAreas && service.relatedAreas.length > 0 && (
        <section class="related-card">
          <div class="related-card__head">
            <span class="section-label">Recovery by area</span>
            <h2>Car recovery in your area</h2>
          </div>
          <ul class="related-card__links">
            {service.relatedAreas.map((r) => (
              <li>
                <a href={r.href}>
                  <span>{r.label}</span>
                  <Icon name="arrow-right" size={16} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )}

  <PhoneCTA
    tone="emergency"
    heading={`Need ${service.name.toLowerCase()} now?`}
    lead="One call. Fixed quote. Flatbed dispatched."
  />

  <Process />

  <ReviewsGoogle />

  <AreasCovered />

  <FAQ items={combinedFaqs} heading={`${service.name}: your questions, answered.`} />

  <ServicesNav
    heading="Other services"
    eyebrow="More from our operation"
    filterSlugs={otherServices}
  />

  <PhoneCTA tone="navy" />
</BaseLayout>

<style>
  .related-stack {
    padding-block: 1.5rem 3rem;
    display: grid;
    gap: 1.25rem;
  }

  .related-card {
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    background: var(--color-neutral-50);
    padding: 1.5rem;
  }

  .related-card__head h2 {
    margin-top: 0.45rem;
    font-size: clamp(1.3rem, 1.8vw, 1.6rem);
  }

  .related-card__links {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .related-card__links li {
    margin: 0;
  }

  .related-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-primary-800);
    font-weight: 700;
    line-height: 1.2;
    transition: border-color 180ms ease, box-shadow 180ms ease, color 180ms ease;
  }

  .related-card__links a :global(svg) {
    color: var(--color-accent-600);
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .related-card__links a:hover {
    border-color: var(--color-primary-700);
    color: var(--color-primary-900);
    box-shadow: 0 6px 18px -10px rgba(0, 0, 0, 0.3);
  }

  .related-card__links a:hover :global(svg) {
    transform: translateX(2px);
  }

  @media (min-width: 900px) {
    .related-stack {
      grid-template-columns: repeat(2, 1fr);
      align-items: start;
    }
  }
</style>
