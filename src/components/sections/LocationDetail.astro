---
import Icon from "../ui/Icon.astro";
import { locations, business } from "../../data";
import type { Location } from "../../data/locations";

interface Props {
  location: Location;
}

const { location } = Astro.props;
const isDraft = location.intro.startsWith("[DRAFT]");
const body = isDraft ? location.intro.replace(/^\[DRAFT\]\s*/, "") : location.intro;

const baseLocation = location.basedAt
  ? locations.find((l) => l.slug === location.basedAt)
  : undefined;
const baseLabel = baseLocation
  ? `Dispatched from ${baseLocation.name}`
  : "Operating base";

// Our verified operating bases (no `basedAt`), minus the page we're on.
// Used to cross-link recovery between bases with descriptive anchors,
// concentrating "car recovery <base>" link equity on the base pages.
const otherBases = locations.filter(
  (l) => !l.basedAt && l.slug !== location.slug,
);

// Split a section body on blank lines so a long block can render as a
// lead-in paragraph, an optional bullet list, then any wrap-up paragraphs.
function paragraphs(text: string): string[] {
  return text.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
}
---

<section class="loc-detail">
  <div class="container-page loc-detail__inner">
    <div class="loc-detail__body">
      {isDraft && (
        <span class="loc-detail__draft">Draft copy, to be reviewed by client</span>
      )}
      <p class="loc-detail__intro">{body}</p>
      <div class="loc-detail__sections">
        {location.detailSections.map((section) => {
          const [lead, ...rest] = paragraphs(section.body);
          return (
            <section class="loc-detail__section">
              <h2>{section.heading}</h2>
              {lead && <p>{lead}</p>}
              {section.bullets && section.bullets.length > 0 && (
                <ul class="loc-detail__list">
                  {section.bullets.map((b) => (
                    <li><Icon name="check" size={18} /><span>{b}</span></li>
                  ))}
                </ul>
              )}
              {rest.map((p) => <p>{p}</p>)}
            </section>
          );
        })}
      </div>
      {location.slug === "perivale" && (
        <div class="loc-detail__callout">
          <span class="section-label">Perivale car pound</span>
          <h2>Need help collecting from Perivale car pound?</h2>
          <p>
            If your vehicle is being held at Perivale car pound and cannot be
            driven away, we can arrange flatbed collection and delivery once
            the release paperwork is ready.
          </p>
          <a href="/services/police-pound-release/">
            See police pound release <Icon name="arrow-right" size={16} />
          </a>
        </div>
      )}

      {otherBases.length > 0 && (
        <nav class="loc-detail__bases" aria-label="Recovery from our other bases">
          <span class="section-label">Recovery from our other bases</span>
          <ul>
            {otherBases.map((b) => (
              <li>
                <a href={`/areas/${b.slug}/`}>
                  Car recovery in {b.name} <Icon name="arrow-right" size={14} />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <dl class="loc-detail__meta">
        <div>
          <dt>{baseLabel}</dt>
          <dd>
            {location.address.street}, {location.address.locality}<br />
            {location.address.region} <span class:list={[location.address.postcode.startsWith("[TK") && "tk"]}>{location.address.postcode}</span>
          </dd>
        </div>
        <div>
          <dt>Average response</dt>
          <dd>{location.responseMinutes} minutes</dd>
        </div>
        {!location.basedAt && (
          <div>
            <dt>Verified address</dt>
            <dd>{location.verified ? "Yes, Google Business Profile verified" : "Pending verification"}</dd>
          </div>
        )}
      </dl>
    </div>

    <aside class="loc-detail__rail">
      <div class="loc-detail__call">
        <span class="section-label-dark">24/7 dispatch</span>
        <p>Speak to a recovery operator now and get a fixed quote before the truck leaves the yard.</p>
        <a href={business.phone.href} class="loc-detail__call-btn" data-astro-prefetch="false">
          <Icon name="phone" size={18} />
          {business.phone.display}
        </a>
      </div>

      <div class="loc-detail__areas">
        <span class="section-label">Nearby areas we cover</span>
        <ul>
          {location.nearbyAreas.map((a) => (
            <li><Icon name="map-pin" size={14} /> {a}</li>
          ))}
        </ul>
      </div>

      <div class="loc-detail__badges">
        <span class="section-label">Operator checks</span>
        <ul>
          <li><Icon name="check" size={16} /><span>PAS43 2012 certified</span></li>
          <li><Icon name="check" size={16} /><span>Full O-Licence holder</span></li>
          <li><Icon name="check" size={16} /><span>IVR-trained drivers</span></li>
          <li><Icon name="check" size={16} /><span>24/7, {location.responseMinutes}-min typical response</span></li>
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .loc-detail {
    background: #fff;
  }
  .loc-detail__inner {
    padding-block: 3.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  .loc-detail__body p {
    color: var(--color-neutral-800);
    line-height: 1.7;
    font-size: 1.125rem;
    max-width: 66ch;
  }
  .loc-detail__body p + p {
    margin-top: 1.1rem;
  }
  .loc-detail__intro {
    font-size: 1.2rem;
    color: var(--color-neutral-900);
  }
  .loc-detail__sections {
    display: grid;
    gap: 2.75rem;
    margin-top: 2.75rem;
  }
  .loc-detail__section h2 {
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    margin: 0 0 0.75rem;
  }
  .loc-detail__section p {
    margin: 0;
  }

  /* Scannable bullet lists inside a section: lead-in -> list -> wrap-up */
  .loc-detail__list {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: grid;
    gap: 0.7rem;
    max-width: 66ch;
  }
  .loc-detail__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
    color: var(--color-neutral-800);
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .loc-detail__list li :global(svg) {
    color: var(--color-accent-600);
    margin-top: 0.28rem;
  }
  .loc-detail__list + p {
    margin-top: 1.1rem;
  }

  .loc-detail__callout {
    margin-top: 2.75rem;
    padding: 1.35rem;
    border: 1px solid var(--color-neutral-200);
    border-left: 4px solid var(--color-accent-500);
    border-radius: var(--radius-md);
    background: var(--color-neutral-50);
    max-width: 66ch;
  }
  .loc-detail__callout h2 {
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    margin-top: 0.4rem;
  }
  .loc-detail__callout p {
    font-size: 1.05rem;
  }
  .loc-detail__callout a {
    margin-top: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary-700);
    font-weight: 700;
  }

  .loc-detail__draft {
    display: inline-block;
    background: var(--color-accent-100);
    color: var(--color-emergency-700);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-xs);
    margin-bottom: 1rem;
  }

  .loc-detail__bases {
    margin-top: 2.75rem;
    max-width: 66ch;
  }
  .loc-detail__bases ul {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .loc-detail__bases a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-sm);
    background: var(--color-neutral-50);
    color: var(--color-primary-700);
    font-weight: 700;
    transition: border-color 180ms ease, color 180ms ease;
  }
  .loc-detail__bases a:hover {
    border-color: var(--color-primary-700);
    color: var(--color-accent-600);
  }
  .loc-detail__bases a :global(svg) {
    color: var(--color-accent-600);
  }

  .loc-detail__meta {
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    border-top: 1px solid var(--color-neutral-200);
    padding-top: 1.5rem;
  }

  .loc-detail__meta dt {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-primary-700);
    margin-bottom: 0.25rem;
  }
  .loc-detail__meta dd {
    margin: 0;
    color: var(--color-neutral-800);
    line-height: 1.45;
  }

  /* ---- Right rail: call card + nearby areas + operator checks ---- */
  .loc-detail__rail {
    display: grid;
    gap: 1rem;
    align-self: start;
  }

  .loc-detail__call {
    background: var(--color-primary-900);
    border: 1px solid var(--color-primary-900);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .loc-detail__call p {
    margin: 0.6rem 0 1rem;
    color: var(--color-neutral-200);
    line-height: 1.5;
  }
  .loc-detail__call-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    color: #fff;
    letter-spacing: -0.005em;
  }
  .loc-detail__call-btn :global(svg) {
    color: var(--color-accent-400);
  }
  .loc-detail__call-btn:hover {
    color: var(--color-accent-400);
  }

  .loc-detail__areas {
    background: var(--color-neutral-50);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .loc-detail__areas ul {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1rem;
  }
  .loc-detail__areas li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-neutral-800);
    font-size: 1rem;
  }
  .loc-detail__areas li :global(svg) {
    color: var(--color-accent-600);
  }

  .loc-detail__badges {
    background: var(--color-neutral-50);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .loc-detail__badges ul {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.6rem;
  }
  .loc-detail__badges li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
    align-items: start;
    color: var(--color-neutral-800);
    line-height: 1.4;
  }
  .loc-detail__badges li :global(svg) {
    color: var(--color-accent-600);
    margin-top: 2px;
  }

  @media (min-width: 768px) {
    .loc-detail__meta { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 900px) {
    .loc-detail__inner {
      grid-template-columns: 1.5fr 1fr;
      gap: 3rem;
    }
    .loc-detail__rail {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }
  }
</style>
